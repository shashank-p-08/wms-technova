PORT=3000
# development | test | production. Production refuses to start with unsafe settings
# (missing JWT/DB secret, DB_SYNCHRONIZE=true, no CORS_ORIGINS).
NODE_ENV=development

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Browser origins allowed to call the API, comma-separated (required in production)
CORS_ORIGINS=http://localhost:5173
# true behind an AWS load balancer so rate limiting sees real client IPs
TRUST_PROXY=false
# Per client IP, per minute
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Schema management
# ---------------------------------------------------------------------------
# Defaults: development -> synchronize (tables follow the entities automatically);
#           production  -> migrations applied at startup.
# DB_SYNCHRONIZE=true
# DB_MIGRATIONS_RUN=false
# DB_POOL_SIZE=10
# DB_LOGGING=false   # true logs every SQL query

# ---------------------------------------------------------------------------
# Database - choose ONE of the two options
# ---------------------------------------------------------------------------
# Option A: local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=technova_wms

# Option B: AWS RDS. Credentials, host, port and dbname come from the Secrets
# Manager secret created by the foundation stack (output: DbSecretArn).
# Remove the Option A lines when using this.
# DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:<account-id>:secret:technova-wms/<env>/db-master-XXXXXX
# DB_SSL=true
# DB_SSL_CA_PATH=certs/rds-global-bundle.pem   # download with scripts/get-rds-ca.ps1
# DB_HOST / DB_PORT here override the secret, e.g. to go through an SSM tunnel.

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Token signing key, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# On AWS use JWT_SECRET_ARN (stack output JwtSecretArn) instead.
JWT_SECRET=
# JWT_SECRET_ARN=arn:aws:secretsmanager:us-east-1:<account-id>:secret:technova-wms/<env>/jwt-signing-key-XXXXXX
JWT_EXPIRES_IN=8h

# First admin, created only when the database has no users yet.
# If ADMIN_PASSWORD is empty, a random one is generated and printed once in the server log.
# Forgot it?  npm run build && npm run reset-password -- admin@technova.local
ADMIN_EMAIL=admin@technova.local
ADMIN_PASSWORD=
COMPANY_NAME=TechNova Logistics

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
# Product image bucket (stack output: AssetsBucketName)
S3_BUCKET_NAME=technova-wms-dev-assets-<account-id>-us-east-1

# Local Floci emulator only. On AWS, remove all three: the API uses its IAM role.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
