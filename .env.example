# Environment for the scripts in scripts/python and scripts/deploy-infra.ps1.
# Copy to .env (git-ignored) or set these in your shell.

# Primary region; the DR region is us-west-2
AWS_REGION=us-east-1

# --- Local development against the Floci emulator -------------------------
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Real AWS ---------------------------------------------------------------
# Remove AWS_ENDPOINT_URL and the keys above, then sign in with IAM Identity
# Center instead of long-lived keys:
#   aws configure sso --profile technova-dev
#   aws sso login --profile technova-dev
# AWS_PROFILE=technova-dev
